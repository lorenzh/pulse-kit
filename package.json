{
  "name": "@lorenzh/pulse-kit",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Shared runtime helpers for the pulse services: env settings, shutdown, ops server, metrics, logging and small HTTP and timer helpers.",
  "type": "module",
  "engines": {
    "bun": "1.4.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./format-duration": {
      "types": "./dist/format-duration.d.ts",
      "default": "./dist/format-duration.js"
    },
    "./escape": {
      "types": "./dist/escape.d.ts",
      "default": "./dist/escape.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun node_modules/typescript7/bin/tsc -p tsconfig.build.json",
    "typecheck": "bun node_modules/typescript7/bin/tsc --noEmit",
    "test": "bun test",
    "lint": "biome check . && pulse-eslint .",
    "format": "biome check --write .",
    "prepare": "lefthook install || true",
    "check": "bun run lint && bun run build && bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@lorenzh/pulse-config": "github:lorenzh/pulse-config#51e95b0eb463b27a196a33b428607bd92443e4f0",
    "@types/node": "^26.6.5",
    "lefthook": "2.2.2",
    "typescript7": "npm:typescript@^7.0.2",
    "@types/bun": "1.4.0"
  },
  "packageManager": "bun@1.4.0"
}
